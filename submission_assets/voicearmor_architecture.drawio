          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Engine -> Arduino Bridge (Cross-border USB Serial) -->
        <mxCell id="edge_serial" value="USB Serial Byte: 0xA1 (Trigger Alert)&lt;br&gt;or 0xA0 (Standby / Clear)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontFamily=Segoe UI;fontSize=10.5;fontStyle=1;fontColor=#D96B27;strokeColor=#D96B27;strokeWidth=2.4;" edge="1" parent="1" source="node_engine" target="node_arduino_bridge">
