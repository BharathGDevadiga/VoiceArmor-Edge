        <mxCell id="edge_2" value="Float32 Tensor&lt;br&gt;[1, 1, 64, 96]" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontFamily=Segoe UI;fontSize=10;fontColor=#333333;strokeColor=#1954A6;strokeWidth=1.8;" edge="1" parent="1" source="node_dsp" target="node_npu">
