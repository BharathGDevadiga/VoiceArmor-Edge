          <mxGeometry x="280" y="60" width="200" height="65" as="geometry" />
        </mxCell>

        <!-- NODE 5: Toast Notification -->
        <mxCell id="node_toast" value="&lt;b&gt;Windows Toast Alert&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px; color: #555555;&quot;&gt;On-screen Visual Banner&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Segoe UI;fontSize=11;fillColor=#FFFDE7;strokeColor=#FBC02D;strokeWidth=1.5;shadow=1;" vertex="1" parent="box_pc">
          <mxGeometry x="525" y="62.5" width="150" height="60" as="geometry" />
        </mxCell>

        <!-- NODE 6: Arduino Bridge -->
