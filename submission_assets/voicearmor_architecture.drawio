        <!-- NODE 1: Audio Input -->
        <mxCell id="node_audio" value="&lt;b&gt;Incoming Call Audio&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px; color: #555555;&quot;&gt;Teams / Zoom / WhatsApp&lt;br&gt;16 kHz Mono Stream&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Segoe UI;fontSize=11;fillColor=#FFFFFF;strokeColor=#1954A6;strokeWidth=1.5;shadow=1;" vertex="1" parent="box_pc">
          <mxGeometry x="30" y="60" width="180" height="65" as="geometry" />
        </mxCell>

        <!-- NODE 2: Audio DSP -->
        <mxCell id="node_dsp" value="&lt;b&gt;Audio DSP Pipeline&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px; color: #555555;&quot;&gt;25ms Hanning + STFT&lt;br&gt;64-band Log-Mel Filterbank&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Segoe UI;fontSize=11;fillColor=#EBF3FB;strokeColor=#1954A6;strokeWidth=1.5;shadow=1;" vertex="1" parent="box_pc">
          <mxGeometry x="30" y="180" width="180" height="70" as="geometry" />
        </mxCell>

        <!-- NODE 3: Hexagon NPU -->
        <mxCell id="node_npu" value="&lt;b&gt;Qualcomm® Hexagon™ NPU&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px; color: #555555;&quot;&gt;INT8 Quantized CNN&lt;br&gt;ONNX Runtime + QnnHtp.dll&lt;br&gt;&lt;b style=&quot;color: #007700;&quot;&gt;Latency &amp;lt; 15 ms&lt;/b&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Segoe UI;fontSize=11;fillColor=#E8F5E9;strokeColor=#2E7D32;strokeWidth=2;shadow=1;" vertex="1" parent="box_pc">
          <mxGeometry x="280" y="180" width="200" height="75" as="geometry" />
        </mxCell>

        <!-- NODE 4: Decision Engine -->
