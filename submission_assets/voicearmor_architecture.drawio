        </mxCell>
        
        <!-- ARDUINO CONTAINER -->
        <mxCell id="box_arduino" value="Arduino® UNO Q (Hardware Safety Module)" style="swimlane;whiteSpace=wrap;html=1;fontFamily=Segoe UI;fontSize=13;fontStyle=1;fillColor=#FFF8F0;strokeColor=#D96B27;strokeWidth=2;arcSize=8;rounded=1;collapsible=0;startSize=32;align=left;spacingLeft=12;" vertex="1" parent="1">
          <mxGeometry x="780" y="40" width="340" height="380" as="geometry" />
