  <diagram name="VoiceArmor-Edge Architecture" id="voicearmor-arch">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1169" pageHeight="827" background="#ffffff" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        
        <!-- PC CONTAINER -->
        <mxCell id="box_pc" value="Snapdragon®-Powered HP PC (On-Device Edge Processing)" style="swimlane;whiteSpace=wrap;html=1;fontFamily=Segoe UI;fontSize=13;fontStyle=1;fillColor=#F4F7FC;strokeColor=#1954A6;strokeWidth=2;arcSize=8;rounded=1;collapsible=0;startSize=32;align=left;spacingLeft=12;" vertex="1" parent="1">
