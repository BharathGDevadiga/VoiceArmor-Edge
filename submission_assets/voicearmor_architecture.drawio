          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- CROSS-BOX EDGE: PC to Arduino -->
        <mxCell id="edge_serial" value="USB Serial (Byte 0xA1 Alert / 0xA0 Clear)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontFamily=Segoe UI;fontSize=10;fontStyle=1;fontColor=#D96B27;strokeColor=#D96B27;strokeWidth=2;" edge="1" parent="1" source="node_engine" target="node_ard_bridge">
