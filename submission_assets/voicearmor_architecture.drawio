          <mxGeometry x="30" y="170" width="180" height="65" as="geometry" />
        </mxCell>

        <!-- NODE 8: Audio Relay -->
        <mxCell id="node_relay" value="&lt;b&gt;Hardware Disconnect Relay&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px; color: #555555;&quot;&gt;Normally-closed mic switch&lt;br&gt;Out-of-band call isolation&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Segoe UI;fontSize=11;fillColor=#FFEBEE;strokeColor=#C62828;strokeWidth=1.5;shadow=1;" vertex="1" parent="box_arduino">
